{
  "name": "aiworlded",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "test": "vitest",
    "testrun": "vitest run",
    "dev": "vite --host",
    "build": "prettier --write --log-level silent . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write --log-level silent .",
    "format:check": "prettier --check .",
    "ci": "bun run format:check && bun run testrun && bun run build && git diff --exit-code -- docs",
    "typecheck:strict": "tsc --project tsconfig.strict.json --noEmit",
    "desktop:dev": "electrobun dev",
    "desktop:build": "electrobun build --env=stable",
    "desktop:run": "electrobun run"
  },
  "devDependencies": {
    "electrobun": "^1.18.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-jsdoc": "^1.8.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vite-tsconfig-paths": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@types/three": "^0.185.1",
    "three": "^0.185.1"
  }
}
